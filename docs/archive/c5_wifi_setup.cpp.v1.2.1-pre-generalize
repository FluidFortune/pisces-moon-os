// ──── Scan result table ────
struct ScanRow {
    String           ssid;
    int              rssi;
    int              ch;
    wifi_auth_mode_t auth;
    bool             saved;
};
ScanRow scan_rows[MAX_SCAN_ROWS];
int     scan_row_count = 0;
bool    scan_truncated = false;

// ──── Keyboard state ────
bool kbd_shift = false;
bool kbd_sym   = false;

// ──── Generic touch helpers ────
void drain_touch() {
    int16_t tx, ty;
    while (c5_touch_read(&tx, &ty)) { delay(15); yield(); }
}

void wait_press() {
    drain_touch();
    int16_t tx, ty;
    while (!c5_touch_read(&tx, &ty)) { delay(15); yield(); }
}

