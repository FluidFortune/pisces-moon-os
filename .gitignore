# ─────────────────────────────────────────────
#  Pisces Moon OS — .gitignore
# ─────────────────────────────────────────────

# ── Secrets — NEVER commit real API keys ──
# secrets.h is the working copy with live keys; only secrets.h.example
# (placeholders) is tracked. Both the root and include/ copies are ignored.
secrets.h
include/secrets.h
/secrets.h
**/secrets.h
!secrets.h.example

# ── PlatformIO build output ──
.pio/
.pioenvs/
.piolibdeps/
.clang_complete
.gcc-flags.json

# ── PlatformIO / VS Code workspace state ──
# Keep PiscesMoon.code-workspace (intentional, tracked) but ignore the
# auto-generated .vscode contents that change per-machine.
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
.vscode/extensions.json

# ── OS cruft ──
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini

# ── Editor backups / swap ──
*.swp
*.swo
*~
*.bak
*.orig

# ── Build/firmware artifacts that may land in-tree ──
*.bin
*.elf
*.hex
*.map
*.o
*.a

# ── Python tooling (ghost_partition, wardrive_splitter) ──
__pycache__/
*.pyc
*.pyo
.venv/
venv/
